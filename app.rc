            VALUE "FileVersion",      "1.3.2.75"
            VALUE "InternalName",     "纯白铃"
            VALUE "LegalCopyright",   "Copyright © 2026 两个月亮"
            VALUE "OriginalFilename", "纯白铃.exe"
            VALUE "ProductName",      "纯白铃"
            VALUE "ProductVersion",   "1.3.2.75"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END