# 下载的源码与编译中间产物（产物目录 win-x64/、linux-x64/ 是有意保留的，要进仓库）
_src/
_build/
_build-linux/

# make install 顺手带出来、本工程用不到的副产品（文件仍留在本地，只是不进仓库）
#   share/ffmpeg/examples/  = FFmpeg 官方示例程序（avio_*.c / decode_*.c / mux.c …），编译无关
#   lib/*.def               = 给 MSVC lib.exe 生成 import lib 的中间产物（bin/*.lib 已经有了）
#   lib/pkgconfig/*.pc      = Unix pkg-config 文件，Windows 侧用不上
win-x64/share/
linux-x64/share/
win-x64/lib/*.def
linux-x64/lib/*.def
win-x64/lib/pkgconfig/
linux-x64/lib/pkgconfig/
